  "components": {
    "schemas": {
      "AcceptTermsRequest": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/TermsDocument"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "document",
          "version"
        ],
        "title": "AcceptTermsRequest"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokensResponse"
          }
        },
        "type": "object",
        "required": [
          "user",
          "tokens"
        ],
        "title": "AuthResponse"
      },
      "CreateProductRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "price_cop": {
            "type": "integer",
            "maximum": 50000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Price Cop"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "price_cop"
        ],
        "title": "CreateProductRequest"
      },
      "CreateStoreRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "category": {
