# Copia a `.env` para desarrollo local.
#
# En un dispositivo físico o el emulador, `localhost` apunta al propio teléfono, no a la
# computadora que corre la API — usa la IP de tu LAN (ej. http://192.168.1.50:8000).
# Sin esta variable, la app usa http://localhost:8000 por defecto (solo sirve para `expo start --web`
# en la misma máquina que la API).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
