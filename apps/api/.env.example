# Copia a `.env` para desarrollo local. Todas las variables llevan el prefijo NEIRAPP_.
NEIRAPP_ENVIRONMENT=development
NEIRAPP_DATABASE_URL=postgresql+asyncpg://neirapp:neirapp@localhost:5432/neirapp

# En producción es obligatorio un secreto propio (mínimo 32 caracteres aleatorios):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEIRAPP_JWT_SECRET=

NEIRAPP_CORS_ORIGINS=["http://localhost:5173"]
